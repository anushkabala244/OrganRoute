PORT=5050
NODE_ENV=development
APP_BASE_URL=http://localhost:5050
PRIVATE_UPLOAD_DIR=
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret

# Keep disabled for actual email/SMS delivery. Set true only for local testing;
# codes will be shown in the registration screen and no message will be sent.
DEV_OTP_MODE=false
# In NODE_ENV=development, show a one-time reset link in the form instead of sending email.
DEV_PASSWORD_RESET_MODE=false

# Required when DEV_OTP_MODE is disabled.
EMAIL_USER=
EMAIL_APP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=
